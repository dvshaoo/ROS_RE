# Ignore massive archives & game obb files (3.3 GB+)
00_INBOX/
04_obb/
01_apk/
*.apk
*.obb
*.xz
*.zip
*.tar.gz
*.iso
*.so

# Ignore large binary servers
mitm/frida-server
mitm/frida-server.xz
scratch/frida-server-*

# Ignore transient live-capture scratch data (heap dumps, per-run logs/screens)
# -- these are regenerable via scratch/dump_regions.sh / reply_id_sweep.sh, not
# source, and heap_dump/ alone can be 500MB+ per capture.
scratch/heap_dump/
scratch/sweep_results/
scratch/*.png

# Ignore Python caches
__pycache__/
*.pyc

# Ignore JDK distributions
tools/jdk21/
tools/jdk21.zip

# Ignore Ghidra project database (huge, regenerable via -import of
# 03_lib/libclient_arm64.so with the ROS_RE scripts in scratch/ghidra_scripts/)
scratch/ghidra_project/
scratch/ghidra_*.log
scratch/run_ghidra_*.bat
