<root>
	<Properties>
		<exchangedItemList>
			<!-- 	已兑换的物品		-->
			<Type>	ARRAY <of>	INT32	</of>	</Type>
			<Flags>		BASE_AND_CLIENT			</Flags>
			<Persistent>	true		</Persistent>
		</exchangedItemList>
		<availableExchangeItem>
			<Type>	PYTHON		</Type>
			<Flags>	BASE	</Flags>
			<Default>	{}	</Default>	
		</availableExchangeItem>
	</Properties>

	<BaseMethods>
		<queryAvailableExchangeItem> <Exposed/>
		</queryAvailableExchangeItem>
		<exchangeItem> <Exposed/>
			<Arg>	INT32	</Arg>
		</exchangeItem>
	</BaseMethods>
	
	<ClientMethods>
		<onQueryAvailableExchangeItem>
			<Arg>	PYTHON	</Arg>
			<Arg>	ARRAY <of> INT32 </of> 	</Arg> <!-- 	已兑换的物品		-->
		</onQueryAvailableExchangeItem>
		<onExchangeItem>
			<Arg>	ARRAY <of> INT32 </of> 	</Arg>
			<Arg>	ARRAY <of> INT32 </of> 	</Arg> <!-- 	已兑换的物品		-->
		</onExchangeItem>
		<onExchangeItemFailed>
			<Arg>	STRING	</Arg>
		</onExchangeItemFailed>
	</ClientMethods>
</root>
