    <timerCheckOccupy>
      <Type>    INT32   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
    </timerCheckOccupy>

    <timerProduceTank>
      <Type>    INT32   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
    </timerProduceTank>

    <nextTankTime>
      <Type>    FLOAT   </Type>
      <Default> 0     </Default>
      <Flags>   ALL_CLIENTS  </Flags>
