      <Flags>   CELL_PRIVATE  </Flags>
    </trapID>
    <nickname>
      <Type>    STRING   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
    </nickname>
    <relatedRebornPoint>
      <Type>    INT32   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
    </relatedRebornPoint>

    <tankSerial>
      <Type>    INT32   </Type>
      <Flags>   ALL_CLIENTS  </Flags>
    </tankSerial>

    <tankRoutes>
      <Type>    PYTHON   </Type>
      <Flags>   ALL_CLIENTS  </Flags>
    </tankRoutes>

    <redPlayers>
      <Type>    PYTHON   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
