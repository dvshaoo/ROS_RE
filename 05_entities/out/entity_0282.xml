	<ClientMethods>
		<onQueryAvailableBattleGift>
			<Arg>	PYTHON	</Arg>
			<Arg>	PYTHON	</Arg>
			<Arg>	PYTHON	</Arg>
			<Arg>	PYTHON	</Arg>
		</onQueryAvailableBattleGift>
		<onUpdateBattleGiftInfo>
			<Arg>	PYTHON	</Arg>
			<Arg>	PYTHON	</Arg>
			<Arg>	PYTHON	</Arg>
		</onUpdateBattleGiftInfo>
