			<Arg>		ARRAY <of> INT32 </of>		</Arg>
		</onGetBattleGift>
		<onGetBattleGiftFailed>
			<Arg>		STRING		</Arg>
		</onGetBattleGiftFailed>

		<queryTimeLimitMatchTeamInfo>
			<Arg>	PYTHON	</Arg>
			<Arg>	PYTHON	</Arg>
		</queryTimeLimitMatchTeamInfo>
		<onGetTimeLimitMatchTeamReward>
			<Arg>		ARRAY <of> INT32 </of>		</Arg>
		</onGetTimeLimitMatchTeamReward>
		<syncBattleGiftPlayerHuiliuState>
			<Arg>		BOOL		</Arg>
		</syncBattleGiftPlayerHuiliuState>
