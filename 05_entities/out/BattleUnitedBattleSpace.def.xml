	<CellMethods>
		<onActiveCampWarID>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
		</onActiveCampWarID>
		<chatToCampWar>
			<Arg>     INT32		</Arg>  <!-- campwarid -->
			<Arg>     INT32         </Arg>  <!-- channel -->
			<Arg>     STRING        </Arg>  <!-- content -->
			<Arg>     CHAT_RECIVER  </Arg>  <!-- sender -->
			<Arg>     CHAT_PARAMS   </Arg>  <!-- params -->
		</chatToCampWar>
		<broadcastQuickMessageToCampMember>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
			<Arg>	PYTHON	</Arg>
		</broadcastQuickMessageToCampMember>
		<broadcastQuickMessageVoToCompMember>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
		</broadcastQuickMessageVoToCompMember>
		<onPlayerRebornLand>
			<Arg>		INT32			</Arg>
			<Arg>		PYTHON		</Arg>
		</onPlayerRebornLand>
	</CellMethods>

	<ClientMethods>
		<onActiveCampWarID>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
		</onActiveCampWarID>

		<syncCampAliveAmountDict>
			<Arg>	PYTHON	</Arg>
		</syncCampAliveAmountDict>

		<syncCampAliveAmount>
			<Arg>	PYTHON	</Arg>	<!-- camp alive amount dict -->
		</syncCampAliveAmount>

		<showGameResult>
			<Arg>	INT32	</Arg>	<!-- winner camp -->
			<Arg>	ARRAY	<of>	AVATAR_CAMP_WAR_GAME_STATUS	</of>	</Arg>
			<Arg>	FLOAT	</Arg>	<!-- show Time -->
		</showGameResult>
		<syncCampWarID>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
		</syncCampWarID>
		<showStrengthTips>
			<Arg>	STRING	</Arg>
		</showStrengthTips>
		<showNearlyEndTipsByKill>
			<Arg>	INT32	</Arg>
			<Arg>	INT32	</Arg>
		</showNearlyEndTipsByKill>
		<showNearlyEndTipsByTime>
			<Arg>	INT32	</Arg>
		</showNearlyEndTipsByTime>
		<notifyLastCircle>
		</notifyLastCircle>
		<syncCampScore>
			<Arg>	PYTHON	</Arg>
		</syncCampScore>
	</ClientMethods>
</root>
