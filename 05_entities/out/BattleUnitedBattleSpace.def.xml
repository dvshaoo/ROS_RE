			<Type>	BOOL	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
			<Default>	false	</Default>
		</isRebornPlaneCreating>
		<zombieQueenTimerID>
			<Type>	INT32	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</zombieQueenTimerID>
		<syncPlayersPosTimer>
			<Type>	INT32	</Type>
			<Flags>	CELL_PUBLIC	</Flags>
		</syncPlayersPosTimer>
		<in2020GamePlayersPos>
			<Type>	ARRAY <of> BATTLE_UNITED_BATTLE_SPACE_ENTITY_POS </of>	</Type>
			<Flags>         ALL_CLIENTS     </Flags>
		</in2020GamePlayersPos>
