		</teamIDToCampWarID>
		<playerInitCampIDs>
			<Type>	PYTHON	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</playerInitCampIDs>
		<campTeamCnt>
			<Type>	PYTHON	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</campTeamCnt>

		<entityIDToCampWarID>
			<Type>	PYTHON	</Type>
			<Flags>	ALL_CLIENTS	</Flags>
		</entityIDToCampWarID>

		<campAliveAmountDict>
			<Type>	PYTHON	</Type>
			<Flags>	ALL_CLIENTS	</Flags>
		</campAliveAmountDict>
		<playerStats>
			<Type>	PYTHON	</Type>
			<Flags>	CELL_PUBLIC	</Flags>
		</playerStats>			
		<gameEndTimer>
			<Type>	INT32	</Type>
			<Flags>	CELL_PUBLIC	</Flags>
		</gameEndTimer>
		<gameEnd30SecTimer>
			<Type>	INT32	</Type>
			<Flags>	CELL_PUBLIC	</Flags>
		</gameEnd30SecTimer>
		<gameEnd60SecTimer>
			<Type>	INT32	</Type>
			<Flags>	CELL_PUBLIC	</Flags>
		</gameEnd60SecTimer>
		<gameEndTime>
			<Type>	LONGTIME </Type>
			<Flags>	ALL_CLIENTS	</Flags>
		</gameEndTime>
		<diedPlayers>
			<Type>	PYTHON	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</diedPlayers>
		<cachedPlayerDict>
			<Type>	PYTHON	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
			<Default>	{}		</Default>
		</cachedPlayerDict>
		
		<needAirDropEnts>
			<Type>	PYTHON	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</needAirDropEnts>
		<campWarGenDropTimerID>
			<Type>	INT32	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</campWarGenDropTimerID>
		<gameStrengthenTimerID>
			<Type>	INT32	</Type>
			<Flags>	CELL_PRIVATE	</Flags>
