			<!-- 本次登录期间总共获取的银币	-->
			<Type>		INT32			</Type>
			<Flags>		BASE  			</Flags>
			<Default>	0				</Default>
		</sessionSp>
		<everyDayGP>
			<!--		每日战斗内获得金币		-->
			<Type>			INT32		</Type>
			<Flags>			BASE		</Flags>
			<Default>		0			</Default>
			<Persistent>	true		</Persistent>
		</everyDayGP>
		<everyDayGPLastResetTime>
			<!--	每日战斗内获得金币重置时间		-->
			<Type>			INT32		</Type>
			<Flags>			BASE		</Flags>
			<Default>		0			</Default>
			<Persistent>	true		</Persistent>
		</everyDayGPLastResetTime>
		<dailyFirstGame>
			<!--	是否每日首场游戏		-->
			<Type>			BOOL		</Type>
			<Flags>			BASE		</Flags>
			<Default>		1		</Default>
			<Persistent>	true		</Persistent>
		</dailyFirstGame>
		<dailyFirstGameLastResetTime>
			<!--	是否每日首场游戏重置时间		-->
			<Type>			INT32		</Type>
			<Flags>			BASE		</Flags>
			<Default>		0			</Default>
			<Persistent>	true		</Persistent>
		</dailyFirstGameLastResetTime>
		<hasGetNewVersionGPReward>
			<!--	是否已领取新版本金币奖励		-->
			<Type>			BOOL		</Type>
			<Flags>			BASE		</Flags>
			<Default>		0		</Default>
			<Persistent>	true		</Persistent>
		</hasGetNewVersionGPReward>
		<hasGetRC2Reward>
			<!--	是否已领取rc2奖励		-->
			<Type>			BOOL		</Type>
			<Flags>			BASE		</Flags>
			<Default>		0		</Default>
			<Persistent>	true		</Persistent>
		</hasGetRC2Reward>
		<instantExchangedCurrency>
			<!--	快速兑换的货币类型		-->
			<Type>			PYTHON		</Type>
			<Flags>			BASE_AND_CLIENT		</Flags>
			<Default>		{}			</Default>
			<Persistent>	true		</Persistent>
		</instantExchangedCurrency>
		<everyDayShare>
			<!--		每日获得分享币		-->
			<Type>			INT32		</Type>
			<Flags>			BASE_AND_CLIENT		</Flags>
			<Default>		0			</Default>
			<PersistentMongo>	true		</PersistentMongo>
		</everyDayShare>
		<everyDayShareLastResetTime>
			<!--	每日每日获得分享币重置时间		-->
			<Type>			INT32		</Type>
			<Flags>			BASE		</Flags>
			<Default>		0			</Default>
			<PersistentMongo>	true		</PersistentMongo>
		</everyDayShareLastResetTime>
		<extraBattleAwardResetTime>
			<!--	额外奖励重置时间		-->
			<Type>			PYTHON		</Type>
			<Flags>			BASE		</Flags>
			<Default>		{}			</Default>
			<PersistentMongo>	true		</PersistentMongo>
		</extraBattleAwardResetTime>
