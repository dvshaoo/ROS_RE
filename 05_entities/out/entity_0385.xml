<root>
	<Properties>
		<currencyList>
			<!-- 	所有货币，包括金币、钻石		-->
			<Type>	ARRAY <of>	CURRENCY_ITEM	</of>	</Type>
			<Flags>		BASE_AND_CLIENT		</Flags>
			<Persistent>	true			</Persistent>
		</currencyList>
		<freezedCurrencyIDs>
			<!-- 	被冻结的货币		-->
			<Type>	ARRAY <of>	INT32	</of>	</Type>
			<Flags>		BASE_AND_CLIENT		</Flags>
			<Persistent>	true			</Persistent>
		</freezedCurrencyIDs>
		<gp>
			<!-- 		金币 			-->
			<Type>		INT64			</Type>
			<Flags>		BASE_AND_CLIENT		</Flags>
			<Default>	0				</Default>
			<Persistent>	true			</Persistent>
		</gp>
		<sp>
			<!-- 		银币 			-->
			<Type>		UINT64			</Type>
			<Flags>		BASE_AND_CLIENT		</Flags>
			<Default>	0				</Default>
			<Persistent>	true			</Persistent>
		</sp>
		<freeYuanbao>
			<!--		免费元宝		-->
			<Type>		INT64			</Type>
			<Flags>		BASE_AND_CLIENT		</Flags>
			<Default>	0				</Default>
			<Persistent>	true			</Persistent>
		</freeYuanbao>
		<payYuanbao>
			<!--		付费元宝		-->
			<Type>		INT64			</Type>
			<Flags>		BASE_AND_CLIENT		</Flags>
			<Default>	0				</Default>
			<Persistent>	true			</Persistent>
		</payYuanbao>
		<isFreezeYuanbao>
			<!-- 		冻结元宝 			-->
			<Type>		BOOL			</Type>
			<Flags>		BASE_AND_CLIENT		</Flags>
			<Default>	False				</Default>
			<Persistent>	true			</Persistent>
		</isFreezeYuanbao>
