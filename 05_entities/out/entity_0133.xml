			<Arg>   STRING	</Arg>						<!-- GID -->
		</getDiamondPrize>
		<getDiamondPrizeRecord>
			<Arg>   GLOBAL_MAIL_BOX_INFO	</Arg>
		</getDiamondPrizeRecord>
		<getCelebrationPrize>
			<Arg>   GLOBAL_MAIL_BOX_INFO	</Arg>
			<Arg>   INT64	</Arg>						<!-- prizeCount -->
		</getCelebrationPrize>
		<gmClearPool>
		</gmClearPool>

	</BaseMethods>
