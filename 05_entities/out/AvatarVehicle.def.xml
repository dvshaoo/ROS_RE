<root>
	<Implements>
		<Interface>	iBaseWithCell	</Interface>
		<Interface>	iVehicle	</Interface>
	</Implements>
	
	<ClientName>	AvatarVehicle		</ClientName>
	
	<Properties>
		<dragMonsters>
			<Type>		PYTHON		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	[]		</Default>
		</dragMonsters>
		<socketFaceDir>
			<Type>		ARRAY <of> INT32 </of>	</Type>
			<Flags>		CELL_PRIVATE	</Flags>
		</socketFaceDir>
		<jumpSockets>
			<Type>		PYTHON		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	[]		</Default>
		</jumpSockets>
		<numUsedJumpSockets>
			<Type>		INT32		</Type>
