			<Type>		 AVATAR_VEHICLE_CLIENT_STATUS 		</Type>
			<Flags> 		ALL_CLIENTS 				</Flags>
		</clientStatus>

		<needNavi>
			<Type>		 BOOL			</Type>
			<Flags> 	ALL_CLIENTS 	</Flags>
