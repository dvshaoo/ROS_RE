		<casterEMPBomb><Exposed/>
			<Arg>		FLOAT			</Arg>
			<Arg>		FLOAT			</Arg>
			<Arg>		INT32			</Arg>
		</casterEMPBomb>

		<casterNOS><Exposed/>
			<Arg>		INT32			</Arg>
		</casterNOS>

		<casterInvincible><Exposed/>
			<Arg>		INT32			</Arg>
		</casterInvincible>

		<casterSuddBomb><Exposed/>
			<Arg>		INT32			</Arg>
