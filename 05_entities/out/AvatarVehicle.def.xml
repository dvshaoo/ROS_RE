			<Flags> 	CELL_PRIVATE 	</Flags>
		</invincTimerID>

		<timeTrialCDTimer>
			<Type>		 INT32			</Type>
			<Flags> 	CELL_PRIVATE 	</Flags>
		</timeTrialCDTimer>

		<lockedTime>
			<Type>		 FLOAT			</Type>
			<Flags> 	CELL_PRIVATE 	</Flags>
		</lockedTime>

		<locked>
			<Type>		 BOOL			</Type>
			<Flags> 	CELL_PRIVATE 	</Flags>
		</locked>

		<lockedTargetId>
			<Type>		 ENTITY_ID			</Type>
			<Flags> 	CELL_PRIVATE 	</Flags>
