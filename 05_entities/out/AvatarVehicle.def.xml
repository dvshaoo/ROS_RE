		<comboTimer>
			<Type>		 FLOAT			</Type>
			<Flags> 	CELL_PRIVATE 	</Flags>
		</comboTimer>

		<lastRoundFinishTime>
			<Type>		 FLOAT			</Type>
			<Flags> 	CELL_PRIVATE 	</Flags>
		</lastRoundFinishTime>

		<waitingMembers>
			<Type>		ARRAY <of> ENTITY_ID </of>	</Type>
			<Flags> 	CELL_PRIVATE 	</Flags>
		</waitingMembers>

