			<Arg> ARRAY <of> ENTITY_ID </of> </Arg>
			<Arg> ARRAY <of> INT32 </of> </Arg>
			<Arg> ARRAY <of> VECTOR3 </of> </Arg>
		</vehicleThrow>

		<setNumUsedJumpSockets>
			<Arg>	INT32		</Arg>
		</setNumUsedJumpSockets>

		<onAvatarEnterd>
