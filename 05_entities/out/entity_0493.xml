<root>
	<Properties>
		<mails>
			<Type>	ARRAY <of>	PYTHON	</of>	</Type>
			<Flags> 		BASE		</Flags>
			<Persistent>	true		</Persistent>
		</mails>

		<lastReceivedMailID>
			<Type>			INT32		</Type>
			<Flags> 		BASE		</Flags>
			<Default>       -1			</Default>
			<Persistent>	true		</Persistent>
		</lastReceivedMailID>
	</Properties>

	<BaseMethods>
		<requestMails> <Exposed/> </requestMails>

		<requestMailDetail> <Exposed/>
			<Arg>			INT32					</Arg>
		</requestMailDetail>

		<getAwardFromMail> <Exposed/>
			<Arg>			INT32					</Arg>
		</getAwardFromMail>

		<onReceiveSysMail>
			<Arg>			PY_DICT					</Arg>
			<Arg>			INT32					</Arg>
			<Arg>			INT32					</Arg>
		</onReceiveSysMail>

		<deleteMail> <Exposed/>
			<Arg>			INT32					</Arg>
		</deleteMail>

		<delMails>
			<Arg>			PYTHON					</Arg>	<!-- params -->
		</delMails>

		<setInitMailID>
			<Arg>			INT32					</Arg>
		</setInitMailID>
	</BaseMethods>

	<ClientMethods>
		<onMailUpdate>
			<Arg>			PYTHON					</Arg>	<!-- params -->
			<Arg>			PYTHON					</Arg>	<!-- params -->
		</onMailUpdate>

		<onLoadMailDetail>
			<Arg>			INT32					</Arg>
			<Arg>			STRING					</Arg>
			<Arg>			PYTHON					</Arg>	<!-- params -->
		</onLoadMailDetail>

		<onLoadMailDetailFailed>
			<Arg>			INT32					</Arg>
		</onLoadMailDetailFailed>

		<onGetAwardFromMail>
			<Arg>	PYTHON 	</Arg>
		</onGetAwardFromMail>
	</ClientMethods>
</root>
