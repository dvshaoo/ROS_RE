      <Type>    PYTHON   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
    </playerInTrap>

    <life>
      <Type>    INT32   </Type>
      <Flags>   ALL_CLIENTS  </Flags>
    </life>

    <timerRefresh>
      <Type>    INT32   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
    </timerRefresh>
