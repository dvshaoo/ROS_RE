  <Properties>
    <trapID>
      <Type>    INT32   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
    </trapID>

    <charId>
      <Type>    INT32   </Type>
      <Flags>   ALL_CLIENTS  </Flags>
    </charId>

    <occupied>
      <Type>    INT32   </Type>
      <Flags>   CELL_PRIVATE  </Flags>
