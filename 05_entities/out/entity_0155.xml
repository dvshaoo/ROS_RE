		<onChangeGodOBMode>
			<Arg>		UINT8		</Arg>
			<Arg>		GID		</Arg>
		</onChangeGodOBMode>
		<onDrawGunTrajectory>
			<Arg>		DTS_RANGE_GUN_TRAJECTORY	</Arg>
			<Arg>		INT32		</Arg>
		</onDrawGunTrajectory>
