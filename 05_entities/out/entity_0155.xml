		</addGodObserver>

		<removeGodObserver>
			<Arg>			INT32 			</Arg>
		</removeGodObserver>

		<clearAllGodObservers>
		</clearAllGodObservers>

		<onObservedEntityEvent>
			<Arg>		INT32		</Arg>
			<Arg>		PYTHON		</Arg>
		</onObservedEntityEvent>
		<onObservedBulletsChanged>
			<Arg>		INT32		</Arg>
