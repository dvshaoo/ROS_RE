		<godObservers>
			<!-- gid: base mail box -->
			<Type>		PYTHON		</Type>
			<Flags>		BASE	</Flags>
			<Default>	{}	</Default>
		</godObservers>
		<isGod>
			<Type>		BOOL		</Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	FALSE		</Default>
		</isGod>
		<isObservedByGod>	<!-- is observed by god observer -->
			<Type>		BOOL			</Type>
			<Flags>		OWN_CLIENT		</Flags>
			<Default>	FALSE			</Default>
		</isObservedByGod>
		<observedPlaneId>
			<Type>		INT32		</Type>
			<Flags>		OWN_CLIENT	</Flags>
		</observedPlaneId>
		<observedEntityEventBuffer>
			<Type>		PYTHON			</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	[]	</Default>
		</observedEntityEventBuffer>
		<needAddEventToBuffer>
			<Type>		BOOL			</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	FALSE	</Default>
		</needAddEventToBuffer>
