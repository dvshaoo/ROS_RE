	<ClientMethods>
		<onObservedEntityEvent>
			<Arg>		INT32		</Arg>
			<Arg>		PYTHON		</Arg>
		</onObservedEntityEvent>
		<onObservedBulletsChanged>
			<Arg>		INT32		</Arg>
