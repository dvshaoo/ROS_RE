			<Type>		INT32			</Type>
			<Flags>		CELL_PUBLIC_AND_OWN	</Flags>
		</godObserveMode>
		<observeType>
			<Type>		UINT8		</Type>
			<Flags>		OWN_CLIENT	</Flags>
		</observeType>
		<lastGodObEntIdx> <!-- free ob前ob的人-->
			<Type>		INT32			</Type>
			<Flags>		OWN_CLIENT	</Flags>
			<Default>	0	</Default>
		</lastGodObEntIdx> <!-- free ob前ob的人-->
