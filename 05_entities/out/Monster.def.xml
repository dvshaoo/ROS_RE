			<Type>		INT32		</Type>
			<Flags>		CELL_PUBLIC	</Flags>
		</monsterGenGroup>
		<guardEntityID>
			<Type>		INT32		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	0		</Default>>
		</guardEntityID>
