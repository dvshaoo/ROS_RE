			<Flags>		CELL_PRIVATE	</Flags>
		</combatProperties>
		<invincibleHp>
			<Type>		FLOAT		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	0.0		</Default>
		</invincibleHp>
		<dynamicAtkFactor>
			<Type>		FLOAT		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	1.0		</Default>
		</dynamicAtkFactor>
		<dynamicHpFactor>
			<Type>		FLOAT		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	1.0		</Default>
		</dynamicHpFactor>
		<monsterGenID>
			<Type>		INT32		</Type>
			<Flags>		ALL_CLIENTS	</Flags>
		</monsterGenID>
		<serialID>
			<Type>		INT32		</Type>
			<Flags>		ALL_CLIENTS	</Flags>
		</serialID>
