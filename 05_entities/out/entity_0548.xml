		<attackAddition>
			<Type>		FLOAT		</Type>
			<Flags> 	CELL_PUBLIC </Flags>
			<Default>	1.0		</Default>
		</attackAddition>
		<hpAddition>
			<Type>		FLOAT		</Type>
			<Flags> 	CELL_PUBLIC </Flags>
			<Default>	1.0		</Default>
		</hpAddition>
	</Properties>
	<CellMethods>
		<removeEntity>
			<Arg>		ENTITY_ID				</Arg>
			<Arg>		PYTHON					</Arg>
		</removeEntity>
		<onGenCreated>
			<Arg>		MAILBOX			</Arg>	<!-- entBase -->
			<Arg>		PYTHON			</Arg>	<!-- props -->
		</onGenCreated>
