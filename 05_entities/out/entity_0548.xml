		<monsterCreateQueue>
			<Type>		PYTHON		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
		</monsterCreateQueue>

		<timerQueuePop>
			<Type>		INT32		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	-1		</Default>
