<root>
	<Properties>
		<generatorDict>
			<Type>		PYTHON		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
		</generatorDict>
		<monsterGeneratorDict>
			<Type>		PYTHON		</Type>
			<Flags>		CELL_PUBLIC	</Flags>
			<Default>	{}		</Default>
		</monsterGeneratorDict>
		<generateRuleIndex>
			<Type>		INT32		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
		</generateRuleIndex>
		<monsterAmountLimit>
			<Type>		INT32		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
		</monsterAmountLimit>

		<curMonsterAmount>
			<!-- 		当前space怪总数 	-->
			<Type>		INT32		</Type>
			<Flags>		ALL_CLIENTS	</Flags>
			<Default>	0		</Default>
		</curMonsterAmount>

		<killedMonsterAmount>
			<!-- 		杀怪计数 	-->
