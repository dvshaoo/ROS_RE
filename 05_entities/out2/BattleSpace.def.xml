<root>
	<Parent>	DynamicSpace	</Parent>
	<Implements>
		<Interface>	iLatencyCheck	</Interface>
		<Interface>	iRobotGenerate	</Interface>
		<Interface>	iMatchDoubleSideSpace	</Interface>
	</Implements>
	<ClientName>	BattleSpace	</ClientName>
	<Properties>
		<startTime>
			<Type>	FLOAT		</Type>
			<Flags>	ALL_CLIENTS	</Flags>
		</startTime>
		<gameStatus>
			<Type>	INT32		</Type>
			<Flags>	CELL_PUBLIC	</Flags>
		</gameStatus>
		<gameStatusTimerID>
			<Type>	INT32		</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</gameStatusTimerID>
		<initCheckTimerID>
			<Type>	INT32		</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</initCheckTimerID>
		<campDataDict>
			<Type>	BATTLE_CAMP_DATA_DICT	</Type>
			<Flags>	ALL_CLIENTS	</Flags>
		</campDataDict>
		<playerDataDict>
			<Type>	PYTHON		</Type>
			<Flags>	CELL_PUBLIC	</Flags>
			<Default>{}		</Default>
		</playerDataDict>
		<campPlayerRecords>
			<Type>	PYTHON		</Type>
			<Flags>	CELL_PRIVATE	</Flags>
			<Default>{}		</Default>
		</campPlayerRecords>
		<gameResult>
			<Type> BATTLE_GAME_RESULT </Type>
			<Flags> CELL_PRIVATE </Flags>
		</gameResult>
		<winnerCamp>
			<Type>	PYTHON		</Type>
			<Flags>	CELL_PRIVATE	</Flags>
			<Default>0		</Default>
		</winnerCamp>
		<gameLatencyTimerID>
			<Type>	INT32		</Type>
			<Flags>	CELL_PRIVATE	</Flags>
		</gameLatencyTimerID>
		<isDomination>
			<Type>	BOOL		</Type>
			<Flags>	ALL_CLIENTS </Flags>
		</isDomination>
		<dominationRecord>
			<Type>	PYTHON		</Type>
			<Flags>	CELL_PRIVATE	</Flags>
			<Default>	{}	</Default>
		</dominationRecord>

		<rankDValueRet>
			<Type>	PYTHON		</Type>
			<Flags>	CELL_PRIVATE	</Flags>
			<Default>	{}	</Default>
		</rankDValueRet>
	</Properties>
	<ClientMethods>
		<gameEnd>
			<Arg>		INT8			</Arg>
			<Arg>		BATTLE_GAME_RESULT	</Arg>
		</gameEnd>
		<showKillInfo>
			<Arg>		INT32			</Arg>
			<Arg>		INT32			</Arg>
			<Arg>		INT8			</Arg>	<!-- hitType -->
			<Arg>		INT8			</Arg>	<!-- hitPart -->
			<Arg>		INT32			</Arg>	<!-- weaponID or skillID -->
			<Arg>		INT8			</Arg>	<!-- multiKill -->
		</showKillInfo>
	</ClientMethods>
	<CellMethods>
		<createRobot>
			<Arg>		INT32			</Arg>
		</createRobot>
		<requestGameResult><Exposed/>
		</requestGameResult>
		<setDomination>
			<Arg>		BOOL			</Arg>
		</setDomination>
        <onGetRankDValue>
            <Arg>		INT32			</Arg>
            <Arg>       PYTHON          </Arg>
        </onGetRankDValue>
	</CellMethods>
</root>
