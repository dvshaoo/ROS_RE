<root>
  <Implements>
    <Interface> iCell </Interface>
    <Interface> iBaseWithCell </Interface>
    <Interface> iMove </Interface>
  </Implements>

  <ClientName>  DtsPlayerHeritage  </ClientName>

  <Properties>
    <items>
      <Type>  PY_DICT </Type>
      <Flags> ALL_CLIENTS </Flags>
    </items>
    <name>
      <Type>  STRING </Type>
      <Flags> ALL_CLIENTS </Flags>
    </name>
    <drop>
      <Type>  BOOL </Type>
      <Flags> ALL_CLIENTS </Flags>
    </drop>

    <dropping>
      <Type>  BOOL </Type>
      <Flags> ALL_CLIENTS </Flags>
    </dropping>

    <appearanceID>
      <Type>  INT32 </Type>
      <Flags> ALL_CLIENTS </Flags>
    </appearanceID>


    <dropSpeed>
      <Type>  FLOAT </Type>
      <Flags> CELL_PRIVATE </Flags>
    </dropSpeed>

    <additionalItems>
      <Type>  ARRAY <of> PY_DICT </of> </Type>
      <Flags> CELL_PRIVATE </Flags>
      <Default> [] </Default>
    </additionalItems>

    <pickOnce>
      <Type>  BOOL </Type>
      <Flags> CELL_PRIVATE </Flags>
    </pickOnce>

    <pickers>
      <Type>  PYTHON </Type>
      <Flags> CELL_PRIVATE </Flags>
      <Default> set() </Default>
    </pickers>

    <ownerID>
      <Type>  INT32 </Type>
      <Flags> ALL_CLIENTS </Flags>
    </ownerID>

    <teamID>
      <Type>  INT32 </Type>
      <Flags> ALL_CLIENTS </Flags>
    </teamID>
    
    <isStarDiamondNpc>
      <Type>  BOOL </Type>
      <Flags> ALL_CLIENTS </Flags>
      <Default> False </Default>
    </isStarDiamondNpc>
    
	<starDiamondNpcBoxUid>
      <Type>  STRING </Type>
      <Flags> CELL_PRIVATE </Flags>
    </starDiamondNpcBoxUid>
	
	<starDiamondNpcBoxType>
      <Type>  INT32 </Type>
      <Flags> CELL_PRIVATE </Flags>
      <Default> -1 </Default>
    </starDiamondNpcBoxType>
    <trapRadius>
      <Type>  INT32 </Type>
      <Flags> CELL_PRIVATE </Flags>
    </trapRadius>
	<playerID>
	      <Type>  INT32 </Type>
	      <Flags> ALL_CLIENTS </Flags>
	</playerID>
    <destroyTimerInUnitedBattle>
      <Type>  INT32 </Type>
      <Flags> CELL_PRIVATE </Flags>
      <Default> 0 </Default>
    </destroyTimerInUnitedBattle>
    <trainID>
      <Type>  INT32 </Type>
      <Flags> ALL_CLIENTS </Flags>
    </trainID>
    <trainPosition>
      <Type>  VECTOR3 </Type>
      <Flags> ALL_CLIENTS </Flags>
    </trainPosition>
  </Properties>

  <ClientMethods>
    <updataItemAmount>
      <Arg> UUID </Arg>
      <Arg> INT32 </Arg>
    </updataItemAmount>
    <resetItems>
      <Arg>  PY_DICT </Arg>
    </resetItems>
    <syncClientHeritageAnimation>
      <Arg>  STRING </Arg>
      <Arg>  INT32 </Arg>
    </syncClientHeritageAnimation>
	<bindOnTrain>
		<Arg> INT32 </Arg>
		<Arg> VECTOR3 </Arg>
	</bindOnTrain>
  </ClientMethods>

  <CellMethods>
    <tryPickUp> <Exposed/>
      <Arg> UUID </Arg>
      <Arg> INT32 </Arg>
      <Arg> BOOL  </Arg>
    </tryPickUp>

	<tryPickUpForTeammate>	<Exposed/>
		<Arg>	UUID	</Arg>
		<Arg>	INT32	</Arg>
		<Arg>	INT32	</Arg>
	</tryPickUpForTeammate>
    <syncHeritageAnimation> <Exposed/>
      <Arg> STRING </Arg>
      <Arg> INT32 </Arg>
    </syncHeritageAnimation>
	<onEaten>
	</onEaten>

	<onHeroReborn>
		<Arg>	INT32	</Arg>
	</onHeroReborn>
	<addOnTrainItem>
		<Arg>	INT32	</Arg>
	</addOnTrainItem>
  </CellMethods>

  <BaseMethods>
  </BaseMethods>

</root>
