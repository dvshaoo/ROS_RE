		<onRequestResumeDownloadDLC>
		    <Arg>			INT32			</Arg>
		</onRequestResumeDownloadDLC>

		<onSetCurGameEnterMapType>
			<Arg>			INT32			</Arg>
		</onSetCurGameEnterMapType>
