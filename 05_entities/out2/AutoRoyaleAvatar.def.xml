<root>
	<Parent>	BattleGroundAvatar	</Parent>
	<Implements>
		<Interface>	iAutoRoyaleEquip		</Interface>
		<Interface>	iRosMatchAvatar         </Interface>
	</Implements>
	<ClientName>	AutoRoyaleAvatar	</ClientName>
	<Properties>
		<ownAutoAppearanceList>
			<Type>		ARRAY <of>	INT32	</of>		</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	[]		</Default>
		</ownAutoAppearanceList>

		<battleAutoChangeTipTimerID>
			<Type>		INT32	</Type>
			<Flags>		CELL_PRIVATE	</Flags>
			<Default>	0		</Default>
		</battleAutoChangeTipTimerID>

		<teamAutoAppearanceList>
			<Type>		ARRAY <of>	AUTO_APPEARANCE_INFO	</of>		</Type>
			<Flags>		OWN_CLIENT	</Flags>
			<Default>	[]		</Default>
		</teamAutoAppearanceList>

		<battleAutoID>
			<Type>		INT32	</Type>
			<Flags>		OWN_CLIENT	</Flags>
			<Default>	0		</Default>
